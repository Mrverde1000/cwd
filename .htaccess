# Clean URLs for Apache hosts: /about serves about.html, and any request that
# includes .html is redirected to the extensionless address.
Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /about.html  ->  /about   (permanent redirect, hides .html)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /about  ->  /about.html  (served internally, address bar unchanged)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
