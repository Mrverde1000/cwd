# Multi-site static hosting: each domain is served from /srv/sites/<domain>/
# TLS is handled by Coolify's proxy in front of this container, so Caddy
# listens on plain port 80 here.

{
	auto_https off
	admin off
}

:80 {
	# www.example.com -> example.com (one folder per site, no duplicates)
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	# Serve the folder that matches the requested hostname
	root * /srv/sites/{host}
	encode gzip zstd

	# /about.html -> /about (clean URLs)
	@html path_regexp html ^/(.+)\.html$
	redir @html /{re.html.1} permanent

	# /about -> about.html, /dir -> dir/index.html
	try_files {path} {path}.html {path}/ 

	# Long cache for static assets, no cache for pages
	@assets path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.gif *.ico *.woff *.woff2 *.mp4 *.pdf
	header @assets Cache-Control "public, max-age=2592000"
	header -Server

	file_server

	# Health check for Coolify
	respond /healthz "ok" 200

	# Friendly 404 if the site has a 404.html, otherwise Caddy's default
	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}
